# Mufasa SMS environment configuration
NODE_ENV=production
PORT=4000

# Required in production. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# SQLite/sql.js database file path.
# Local default: backend/data.sqlite
# Railway recommended with volume: /data/data.sqlite
# DB_FILE=/data/data.sqlite

# Alternative to DB_FILE: data.sqlite will be placed inside DATA_DIR
# DATA_DIR=/data
