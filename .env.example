# Mufasa SMS environment configuration
NODE_ENV=production
PORT=4000

# Required in production. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# Optional persistent database file path (VPS default uses backend/data.sqlite).
DB_FILE=/data/data.sqlite

# Backup configuration. Recommended VPS path: /root/mufasa-sms-backups.
BACKUP_DIR=/data/backups
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=3
BACKUP_RETENTION_DAYS=30

# Alternative to DB_FILE: data.sqlite will be placed inside DATA_DIR
# DATA_DIR=/data
