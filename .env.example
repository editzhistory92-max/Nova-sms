# Nova SMS VPS environment configuration
NODE_ENV=production
PORT=4000

# Required in production. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-secret

# Optional: if not set, backend/data.sqlite is used.
# DB_FILE=/root/Nova-sms/backend/data.sqlite

# VPS backup configuration. Keep backups outside the app folder.
BACKUP_DIR=/root/nova-sms-backups
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=3
BACKUP_RETENTION_DAYS=30

# Optional alternative to DB_FILE
# DATA_DIR=/root/nova-sms-data
